# ============================================================
# Скопируй этот файл в .env и заполни значения перед деплоем.
# Все секреты должны быть СЛУЧАЙНЫМИ. Сгенерировать можно так:
#   openssl rand -base64 32
# ============================================================

# --- Домен/URL ---
# Адрес, по которому будет доступна API/админка (с https)
STRAPI_URL=https://api.matras-ukish.kz

# Откуда разрешены запросы (фронтенд-домен(ы), через запятую)
ALLOWED_ORIGINS=https://matras-ukish.kz,https://www.matras-ukish.kz

# --- PostgreSQL ---
POSTGRES_DB=ukish
POSTGRES_USER=ukish
POSTGRES_PASSWORD=ЗАМЕНИ_НА_СИЛЬНЫЙ_ПАРОЛЬ

# База, которую использует Strapi (создаётся init-скриптом автоматически)
STRAPI_DB_NAME=ukish_strapi

# --- Strapi секреты (СЛУЧАЙНЫЕ, openssl rand -base64 32) ---
STRAPI_APP_KEYS=key1,key2,key3,key4
STRAPI_API_TOKEN_SALT=ЗАМЕНИ
STRAPI_ADMIN_JWT_SECRET=ЗАМЕНИ
STRAPI_JWT_SECRET=ЗАМЕНИ
STRAPI_TRANSFER_TOKEN_SALT=ЗАМЕНИ
STRAPI_ENCRYPTION_KEY=ЗАМЕНИ
