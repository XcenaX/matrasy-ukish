{
  "kind": "collectionType",
  "collectionName": "ukish_products",
  "info": {
    "singularName": "product",
    "pluralName": "products",
    "displayName": "Товары",
    "description": "Каталог матрасов UKISH"
  },
  "options": {
    "draftAndPublish": false
  },
  "attributes": {
    "title": {
      "type": "string",
      "required": true
    },
    "slug": {
      "type": "uid",
      "targetField": "title",
      "required": true
    },
    "collection": {
      "type": "enumeration",
      "enum": ["Премиум", "Ортопедические", "Детские", "Базовые", "Аксессуары"],
      "required": true,
      "default": "Премиум"
    },
    "hardness": {
      "type": "enumeration",
      "enum": ["Мягкий", "Средней жесткости", "Жесткий", "Разносторонний"],
      "default": "Средней жесткости"
    },
    "shortDescription": {
      "type": "text",
      "required": true
    },
    "description": {
      "type": "text",
      "required": true
    },
    "price": {
      "type": "integer",
      "required": true,
      "min": 0
    },
    "oldPrice": {
      "type": "integer",
      "min": 0
    },
    "image": {
      "type": "media",
      "multiple": false,
      "required": true,
      "allowedTypes": ["images"]
    },
    "gallery": {
      "type": "component",
      "repeatable": true,
      "component": "product.gallery-image"
    },
    "reviewVideo": {
      "type": "media",
      "multiple": false,
      "allowedTypes": ["videos"]
    },
    "sizes": {
      "type": "component",
      "repeatable": true,
      "component": "product.size"
    },
    "details": {
      "type": "component",
      "repeatable": true,
      "component": "product.detail"
    },
    "benefits": {
      "type": "component",
      "repeatable": true,
      "component": "product.benefit"
    },
    "active": {
      "type": "boolean",
      "default": true
    },
    "sortOrder": {
      "type": "integer",
      "default": 100
    }
  }
}
